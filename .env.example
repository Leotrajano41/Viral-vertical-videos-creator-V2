# =====================================================
# VIRAL VERTICAL VIDEOS CREATOR v2.0 - ENV CONFIGURATION
# =====================================================

# App Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Connection (PostgreSQL + PgBouncer)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viral_creator_db?schema=public&sslmode=prefer"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/viral_creator_db?schema=public"

# Redis Cache & BullMQ Queue (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# AWS S3 Storage & CloudFront CDN
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIAYOURAWSACCESSKEY"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_S3_BUCKET_NAME="viral-creator-prod-bucket"
NEXT_PUBLIC_CLOUDFRONT_URL="https://d123456789.cloudfront.net"

# LLM Providers (Multi-LLM Orchestration)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
OPENAI_API_KEY="sk-proj-your-openai-key"
GEMINI_API_KEY="AIzaSyYourGeminiApiKey"

# Media Stock & External APIs
PEXELS_API_KEY="your_pexels_api_key"
PIXABAY_API_KEY="your_pixabay_api_key"
ASSEMBLY_API_KEY="your_assembly_ai_key"

# Google OAuth 2.0 & YouTube Data API v3
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
AES_SECRET_KEY="32_character_hex_secret_encryption_key"

# Stripe SaaS Billing & Webhooks
STRIPE_API_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_pub_key"
