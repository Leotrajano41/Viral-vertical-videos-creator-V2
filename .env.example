# =====================================================
# VIRAL VERTICAL VIDEOS CREATOR v2.0 - PRODUCTION ENV
# Guia Completo de Variáveis de Ambiente para Deploy Vercel
# =====================================================

# ─────────────────────────────────────────────────────
# 1. APP SETTINGS (Configurações Gerais da Aplicação)
# ─────────────────────────────────────────────────────

# URL pública da aplicação em produção (usada para redirects OAuth, links absolutos, etc.)
# Valor: a URL do seu deploy na Vercel (ex: https://viral-videos-creator.vercel.app)
NEXT_PUBLIC_APP_URL="https://viral-videos-creator.vercel.app"

# Ambiente de execução. A Vercel configura automaticamente, mas pode ser definido explicitamente.
NODE_ENV="production"

# ─────────────────────────────────────────────────────
# 2. DATABASE (Banco de Dados PostgreSQL)
# ─────────────────────────────────────────────────────

# URL de conexão principal com o banco PostgreSQL.
# Onde obter: Neon.tech (https://neon.tech) ou Supabase (https://supabase.com) → Criar projeto → Copiar Connection String.
# Formato: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://seu_usuario:sua_senha@ep-xxx.us-east-1.aws.neon.tech/viral_creator_db?sslmode=require"

# URL direta (sem connection pooler). Necessária para migrações do Prisma.
# Onde obter: Mesmo painel do Neon/Supabase, mas copiar a URL "Direct" (sem pooler).
DIRECT_URL="postgresql://seu_usuario:sua_senha@ep-xxx.us-east-1.aws.neon.tech/viral_creator_db?sslmode=require"

# ─────────────────────────────────────────────────────
# 3. AUTHENTICATION (Autenticação JWT & NextAuth)
# ─────────────────────────────────────────────────────

# Chave secreta para assinar tokens JWT de autenticação. NUNCA compartilhe.
# Como gerar: Execute no terminal:  openssl rand -base64 32
JWT_SECRET="GERAR_COM_openssl_rand_-base64_32"

# Chave secreta do NextAuth.js para criptografia de sessões.
# Como gerar: Execute no terminal:  openssl rand -base64 32
NEXTAUTH_SECRET="GERAR_COM_openssl_rand_-base64_32"

# URL canônica da aplicação (usada pelo NextAuth para callbacks OAuth).
# Valor: mesma URL do NEXT_PUBLIC_APP_URL.
NEXTAUTH_URL="https://viral-videos-creator.vercel.app"

# ─────────────────────────────────────────────────────
# 4. REDIS (Cache & Filas BullMQ)
# ─────────────────────────────────────────────────────

# URL de conexão com o Redis para filas de renderização BullMQ.
# Onde obter: Upstash (https://upstash.com) → Criar Redis Database → Copiar Endpoint.
REDIS_URL="redis://default:seu_token@serverless-redis.upstash.io:6379"

# REST URL do Upstash Redis (para uso serverless na Vercel).
# Onde obter: Painel do Upstash → Seção REST API.
UPSTASH_REDIS_REST_URL="https://seu-redis.upstash.io"

# Token de autenticação REST do Upstash Redis.
UPSTASH_REDIS_REST_TOKEN="seu_upstash_rest_token"

# ─────────────────────────────────────────────────────
# 5. AWS S3 STORAGE (Armazenamento de Mídias & Vídeos)
# ─────────────────────────────────────────────────────

# Região da AWS onde o bucket S3 foi criado.
AWS_REGION="us-east-1"

# Chave de acesso da AWS (IAM User com permissão s3:PutObject, s3:GetObject).
# Onde obter: AWS Console → IAM → Users → Create Access Key.
AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"

# Chave secreta da AWS correspondente.
AWS_SECRET_ACCESS_KEY="sua_chave_secreta_aws_40_caracteres"

# Nome do bucket S3 criado para armazenar vídeos, áudios e documentos.
# Onde obter: AWS Console → S3 → Create Bucket.
AWS_S3_BUCKET_NAME="viral-creator-prod-bucket"

# URL pública do CloudFront CDN (opcional, para servir vídeos com baixa latência).
# Onde obter: AWS Console → CloudFront → Create Distribution → Apontar para o bucket S3.
NEXT_PUBLIC_CLOUDFRONT_URL="https://dxxxxxxxxxx.cloudfront.net"

# ─────────────────────────────────────────────────────
# 6. LLM PROVIDERS (Provedores de IA Multi-LLM)
# ─────────────────────────────────────────────────────

# Chave da API do OpenRouter (provedor primário, mais barato).
# Onde obter: https://openrouter.ai/keys → Create Key.
OPENROUTER_API_KEY="sk-or-v1-sua_chave_openrouter"

# Chave da API da OpenAI (fallback secundário).
# Onde obter: https://platform.openai.com/api-keys → Create New Secret Key.
OPENAI_API_KEY="sk-proj-sua_chave_openai"

# Chave da API do Google Gemini (fallback terciário).
# Onde obter: https://aistudio.google.com/apikey → Create API Key.
GEMINI_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ─────────────────────────────────────────────────────
# 7. MEDIA STOCK APIs (Busca de Mídia B-Roll)
# ─────────────────────────────────────────────────────

# Chave da API do Pexels (vídeos e imagens de estoque gratuitos).
# Onde obter: https://www.pexels.com/api/ → Get API Key.
PEXELS_API_KEY="sua_chave_pexels"

# Chave da API do Pixabay (alternativa ao Pexels).
# Onde obter: https://pixabay.com/api/docs/ → Get API Key.
PIXABAY_API_KEY="sua_chave_pixabay"

# Chave da API do AssemblyAI (transcrição de áudio/vídeo para legendas).
# Onde obter: https://www.assemblyai.com/dashboard → API Key.
ASSEMBLY_API_KEY="sua_chave_assemblyai"

# ─────────────────────────────────────────────────────
# 8. GOOGLE OAUTH 2.0 & YOUTUBE DATA API v3
# ─────────────────────────────────────────────────────

# Client ID do Google OAuth 2.0 para publicação no YouTube.
# Onde obter: https://console.cloud.google.com → APIs & Services → Credentials → Create OAuth Client ID.
# IMPORTANTE: Adicionar a URL de callback em "Authorized redirect URIs":
#   https://viral-videos-creator.vercel.app/api/youtube/callback
GOOGLE_CLIENT_ID="seu_client_id.apps.googleusercontent.com"

# Client Secret do Google OAuth 2.0.
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"

# Chave AES-256 para criptografar Refresh Tokens do YouTube em repouso no banco de dados.
# Como gerar: Execute no terminal:  openssl rand -hex 16
AES_SECRET_KEY="GERAR_COM_openssl_rand_-hex_16"

# ─────────────────────────────────────────────────────
# 9. STRIPE (Monetização SaaS & Billing)
# ─────────────────────────────────────────────────────

# Chave secreta do Stripe (para cobranças server-side).
# Onde obter: https://dashboard.stripe.com/apikeys → Secret Key.
# PRODUÇÃO: usar chave que começa com sk_live_... (não sk_test_...).
STRIPE_API_KEY="sk_live_sua_chave_stripe_secreta"

# Secret do Webhook do Stripe (para receber eventos de pagamento).
# Onde obter: https://dashboard.stripe.com/webhooks → Add Endpoint → Signing Secret.
# Endpoint: https://viral-videos-creator.vercel.app/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_sua_chave_webhook_stripe"

# Chave pública do Stripe (exposta no frontend para Checkout).
# Onde obter: https://dashboard.stripe.com/apikeys → Publishable Key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_sua_chave_stripe_publica"
